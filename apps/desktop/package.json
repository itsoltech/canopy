{
  "name": "@open-agents/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Canopy desktop: a local gateway and worker, or a worker for your remote gateway",
  "author": "Canopy contributors",
  "homepage": "canopy://desktop",
  "desktopName": "canopy.desktop",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:shell": "bun scripts/build-shell.ts",
    "build": "bun scripts/build.ts",
    "package:linux": "bun run build && bun scripts/package.ts",
    "package:mac": "bun run build && bun scripts/package.ts",
    "package:windows": "bun run build && bun scripts/package.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "bun test test/runtime.integration.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@open-agents/contracts": "workspace:*",
    "@open-agents/db": "workspace:*",
    "@open-agents/testing": "workspace:*",
    "@open-agents/ui": "workspace:*"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "18.6.0-beta.19",
    "@embedded-postgres/linux-arm64": "18.6.0-beta.19",
    "@embedded-postgres/darwin-x64": "18.6.0-beta.19",
    "@embedded-postgres/darwin-arm64": "18.6.0-beta.19",
    "@embedded-postgres/windows-x64": "18.6.0-beta.19"
  },
  "build": {
    "appId": "app.canopy.desktop",
    "productName": "Canopy",
    "executableName": "canopy",
    "artifactName": "Canopy-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json", "!node_modules/**"],
    "npmRebuild": false,
    "afterPack": "scripts/verify-package.cjs",
    "extraResources": [
      { "from": "build/runtime", "to": "runtime" },
      { "from": "build/runtime/node_modules", "to": "runtime/node_modules" },
      { "from": "../web/static/icon-512.png", "to": "icon.png" }
    ],
    "protocols": [{ "name": "Canopy enrollment", "schemes": ["canopy"] }],
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64", "arm64"] }, { "target": "deb", "arch": ["x64", "arm64"] }],
      "icon": "../web/static/icon-512.png",
      "category": "Development",
      "syncDesktopName": true,
      "maintainer": "Canopy contributors",
      "desktop": { "entry": { "StartupWMClass": "Canopy" } }
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "../web/static/icon-512.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "../web/static/icon-512.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
