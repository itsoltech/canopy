{
  "expo": {
    "name": "Canopy",
    "slug": "canopy-mobile",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/00e078e3-86cf-493e-adac-6fff27d7f803",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/updates-certificate.pem",
      "codeSigningMetadata": { "keyid": "canopy-updates", "alg": "rsa-v1_5-sha256" }
    },
    "orientation": "default",
    "icon": "../web/static/icon-512.png",
    "scheme": "canopy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "tech.itsol.canopy-remote",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Canopy connects securely to your paired computer on your local network.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "tech.itsol.canopy_remote",
      "predictiveBackGestureEnabled": true
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Canopy to scan a pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Canopy to attach photos to your messages.",
          "cameraPermission": "Allow Canopy to scan a pairing QR code and take photos for your messages.",
          "microphonePermission": false
        }
      ],
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "../web/static/icon-512.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#000000", "image": "../web/static/icon-512.png" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": { "eas": { "projectId": "00e078e3-86cf-493e-adac-6fff27d7f803" } },
    "owner": "itsol"
  }
}
