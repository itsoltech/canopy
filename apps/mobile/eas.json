{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "CANOPY_DEV_HTTP": "1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "channel": "nightly",
      "env": { "CANOPY_CHANNEL": "nightly" },
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-beta": {
      "extends": "preview",
      "env": { "CANOPY_CHANNEL": "beta" },
      "channel": "beta"
    },
    "preview-stable": {
      "extends": "preview",
      "env": { "CANOPY_CHANNEL": "stable" },
      "channel": "stable"
    },
    "production": {
      "channel": "nightly",
      "env": { "CANOPY_CHANNEL": "nightly" },
      "environment": "production",
      "autoIncrement": true
    },
    "production-beta": {
      "extends": "production",
      "env": { "CANOPY_CHANNEL": "beta" },
      "channel": "beta"
    },
    "production-stable": {
      "extends": "production",
      "env": { "CANOPY_CHANNEL": "stable" },
      "channel": "stable"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6768351426",
        "appleTeamId": "5XWLF3YKWM"
      }
    }
  }
}
