# Canopy deployment (deploy/docker-compose.yml, docs/deploy.md). Copy to .env and fill in; never commit .env.

# Image channel: latest (main), v1 (newest 1.x.y), v1.2 (newest 1.2.x) or an exact v1.2.3.
CANOPY_TAG=latest

# PostgreSQL password (also used in the gateway's database URL: keep it URL-safe, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Shared secret of the gateway and the web BFF, at least 32 characters: openssl rand -hex 32
CANOPY_UI_SERVICE_TOKEN=

# Encryption key of the secrets stored by the gateway, 32 random bytes in base64: openssl rand -base64 32
# Keep a copy: without it the stored provider keys and connector tokens cannot be decrypted.
CANOPY_SECRETS_KEY=

# Address workers use to reach the gateway (shown in Settings → Workers enrollment), e.g. https://gateway.example.com
CANOPY_PUBLIC_GATEWAY_URL=

# The single user until sign-in exists.
CANOPY_DEV_USER_EMAIL=dev@localhost

# Published ports. 127.0.0.1 = only through a reverse proxy on this host; 0.0.0.0 = every interface.
WEB_BIND=127.0.0.1
WEB_PORT=3000
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=7443

# Largest upload through the web BFF; at least the gateway's attachment file limit (CANOPY_ATTACHMENT_MAX_FILE_MB).
BODY_SIZE_LIMIT=25M
CANOPY_ATTACHMENT_MAX_FILE_MB=
