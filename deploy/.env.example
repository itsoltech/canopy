# Canopy deployment (deploy/docker-compose.yml, docs/deploy.md). Copy to .env and fill in; never commit .env.

# Image channel: stable (latest stable, also latest), beta (next), nightly (dev), vX, vX.Y or exact vX.Y.Z.
CANOPY_TAG=latest

# PostgreSQL password (also used in the gateway's database URL: keep it URL-safe, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Service token of the gateway's API for its web app, at least 32 characters: openssl rand -hex 32
CANOPY_UI_SERVICE_TOKEN=

# Encryption key of the secrets stored by the gateway, 32 random bytes in base64: openssl rand -base64 32
# Keep a copy: without it the stored provider keys and connector tokens cannot be decrypted.
CANOPY_SECRETS_KEY=

# Published raw TCP port for phones, linked computers and remote workers. Enable in Settings → Network access.
CANOPY_NETWORK_PORT=24443
NETWORK_BIND=0.0.0.0

# Optional: the OAuth redirect URL for Slack and GitHub apps (docs/connectors.md). Empty uses Canopy's fixed
# redirect page; set your own https://…/api/connectors/oauth/callback to skip it.
CANOPY_OAUTH_REDIRECT_URL=

# Public GitHub App overrides for forks. Official defaults are built in; no client secret or private key.
# Set both explicitly empty to disable device sign-in.
# CANOPY_GITHUB_APP_CLIENT_ID=
# CANOPY_GITHUB_APP_SLUG=

# The single user until sign-in exists.
CANOPY_DEV_USER_EMAIL=dev@localhost

# Published ports. 127.0.0.1 = only through a reverse proxy on this host; 0.0.0.0 = every interface.
WEB_BIND=127.0.0.1
WEB_PORT=3000
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=7443

# Web upload limit: 50M fits a 25 MiB skill folder encoded as base64 JSON.
# Keep this at least as large as the file limit chosen in Settings → Network access.
BODY_SIZE_LIMIT=50M

# The gateway serves the web app on WEB_PORT; off = headless (no web on this host).
CANOPY_WEB=on
# The public host name(s) of your reverse proxy, or this host's MagicDNS name (box.tailnet.ts.net) for
# `tailscale serve`, comma-separated (.example.com = its subdomains). IP addresses and localhost always work;
# other names get "421 This host name isn't allowed".
CANOPY_WEB_ALLOWED_HOSTS=
