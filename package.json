{
  "name": "canopy",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "postinstall": "simple-git-hooks",
    "commitlint": "commitlint",
    "gen": "bun run --filter @canopy/contracts gen && bun run --filter @canopy/domain gen",
    "gen:codex": "bun run --filter @canopy/codex-protocol gen",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json && tsc -p tools/tsconfig.json",
    "test": "bun test",
    "check": "bun run gen:check && bun run typecheck && bun run lint && bun run format:check && bun run check:tmp",
    "gen:check": "bun run gen && git diff --exit-code -- packages/contracts/src/gen packages/domain/src/visuals/gen && bun run --filter @canopy/ui gen:check",
    "check:tmp": "bun packages/testing/src/check-temp.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:spacing": "oxlint -c oxlint.spacing.config.ts --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "simple-git-hooks": {
    "commit-msg": "bunx --no-install commitlint --edit \"$1\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@oxlint/plugins": "1.94.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "conventional-changelog-angular": "9.4.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "semantic-release": "25.0.9",
    "simple-git-hooks": "2.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "@electron/universal@2.0.3": {
      "minimatch": "11.0.9"
    },
    "@expo/fingerprint@0.21.10": {
      "minimatch": "11.0.9"
    },
    "app-builder-lib@26.18.0": {
      "minimatch": "11.0.9"
    }
  },
  "patchedDependencies": {
    "@electron/notarize@2.5.0": "patches/@electron%2Fnotarize@2.5.0.patch",
    "app-builder-lib@26.18.0": "patches/app-builder-lib@26.18.0.patch",
    "react-native@0.88.1": "patches/react-native@0.88.1.patch",
    "semantic-release@25.0.9": "patches/semantic-release@25.0.9.patch",
    "svelte@5.59.1": "patches/svelte@5.59.1.patch"
  }
}
