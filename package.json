{
  "name": "open-agents",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tests/*"],
  "scripts": {
    "gen": "bun run --filter @open-agents/contracts gen",
    "gen:codex": "bun run --filter @open-agents/codex-protocol gen",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "check": "bun run gen:check && bun run typecheck && bun run check:tmp",
    "gen:check": "bun run gen && git diff --exit-code -- packages/contracts/src/gen",
    "check:tmp": "bun packages/testing/src/check-temp.ts"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "1.4.4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
